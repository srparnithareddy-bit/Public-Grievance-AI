# Public Grievance AI Assistant (Problem ID: HACK-P438) - Environment Configuration

# Backend Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/public_grievance_db

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# JWT Secret for Authentication & Role Enforcement
JWT_SECRET=hackathon_super_secret_jwt_key_2026
